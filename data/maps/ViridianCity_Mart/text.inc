ViridianCity_Mart_Text_YouCameFromPallet::
    .string "Hey!\n"
    .string "You came from PALLET TOWN?$"

ViridianCity_Mart_Text_TakeThisToProfOak::
    .string "You know PROF. OAK, right?\p"
    .string "His order came in.\n"
    .string "Can I get you to take it to him?$"

ViridianCity_Mart_Text_ReceivedOaksParcelFromClerk::
    .string "{PLAYER} received OAK'S PARCEL\n"
    .string "from the POKéMON MART clerk.$"

ViridianCity_Mart_Text_ReceivedLevelCapCandyFromClerk::
    .string "{PLAYER} received a Cap Candy\n"
    .string "from the POKéMON MART clerk.$"

ViridianCity_Mart_Text_SayHiToOakForMe::
    .string "Oak ordered this too.\p"
    .string "Please give it to him\n"
    .string "and PLEASE don't open it!$"

ViridianCity_Mart_Text_ShopDoesGoodBusinessInAntidotes::
    .string "This shop does good business in\n"
    .string "ANTIDOTES, I've heard.$"

ViridianCity_Mart_Text_GotToBuySomePotions::
    .string "I've got to buy some POTIONS.\p"
    .string "You never know when your POKéMON\n"
    .string "will need quick healing.$"


ViridianCity_Mart_Text_CapCandyGift::
    .string "GIOVANNI ordered this CAP CANDY,\n"
    .string "but he never picked it up.\p"
    .string "As thanks for taking OAK's parcel,\n"
    .string "I'd like you to have it!$"

ViridianCity_Mart_Text_ExplainCapCandy::
    .string "CAP CANDY raises a POKéMON to\n"
    .string "your current level cap.\p"
    .string "Use it from the BAG or register\n"
    .string "it to the item wheel.\p"
    .string "It's reusable, so hang on to it!$"

ViridianCity_Mart_Text_NoRoomForCapCandy::
    .string "I've got a gift for helping me,\n"
    .string "but your KEY ITEMS pocket is full.\p"
    .string "Make room and talk to me again.\n"
    .string "I'll keep it here for you!$"
