QuantumCoastalCityPokemonCenter1F_MapScripts::
	map_script MAP_SCRIPT_ON_TRANSITION, QuantumCoastalCityPokemonCenter1F_OnTransition
	map_script MAP_SCRIPT_ON_RESUME, CableClub_OnResume
	.byte 0

QuantumCoastalCityPokemonCenter1F_OnTransition::
	goto_if_unset FLAG_QUANTUM_ARRIVED, QuantumCoastalCityPokemonCenter1F_End
	setflag FLAG_QUANTUM_COASTAL_CENTER
	setrespawn HEAL_LOCATION_QUANTUM_COASTAL_CITY
QuantumCoastalCityPokemonCenter1F_End::
	end

QuantumCoastalCityPokemonCenter1F_Nurse::
