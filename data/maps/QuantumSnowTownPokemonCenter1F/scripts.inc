QuantumSnowTownPokemonCenter1F_MapScripts::
	map_script MAP_SCRIPT_ON_TRANSITION, QuantumSnowTownPokemonCenter1F_OnTransition
	map_script MAP_SCRIPT_ON_RESUME, CableClub_OnResume
	.byte 0

QuantumSnowTownPokemonCenter1F_OnTransition::
	goto_if_unset FLAG_QUANTUM_ARRIVED, QuantumSnowTownPokemonCenter1F_End
	setflag FLAG_QUANTUM_SNOW_CENTER
	setrespawn HEAL_LOCATION_QUANTUM_SNOW_TOWN
QuantumSnowTownPokemonCenter1F_End::
	end

QuantumSnowTownPokemonCenter1F_Nurse::
	lock
	faceplayer
	call EventScript_PkmnCenterNurse
	release
	end
