Route2_EastBuilding_Text_GiveHM05IfSeen10Mons::
    .string "Hi! Remember me?\n"
    .string "I'm one of PROF. OAK's AIDES.\p"
    .string "If your POKéDEX has recorded\n"
    .string "on ten species, I'm supposed to\l"
    .string "give you a reward.\p"
    .string "PROF. OAK entrusted me with\n"
    .string "a Lantern for you.\p"
    .string "So, {PLAYER}, let me ask you.\p"
    .string "Have you seen at least\n"
    .string "ten kinds of POKéMON?$"

Route2_EastBuilding_Text_GreatHereYouGo::
    .string "Great! You have seen\n"
    .string "{STR_VAR_3} kinds of POKéMON!\p"
    .string "Congratulations!\n"
    .string "Here you go!$"

Route2_EastBuilding_Text_ReceivedHM05FromAide::
    .string "{PLAYER} received a Lantern\n"
    .string "from the AIDE.$"

Route2_EastBuilding_Text_ExplainHM05::
    .string "The Lantern lights up dark caves.\p"
    .string "With the BOULDERBADGE, use it\n"
    .string "from Key Items in a dark cave.\p"
    .string "You can register it to the wheel!$"

Route2_EastBuilding_Text_CanGetThroughRockTunnel::
    .string "Your Lantern can light the way\n"
    .string "through ROCK TUNNEL.$"


Route2_EastBuilding_Text_NotEnoughSeen::
    .string "You've seen {STR_VAR_3} kinds of POKéMON.\p"
    .string "Come back when you've seen ten\n"
    .string "and the Lantern is yours!$"

Route2_EastBuilding_Text_DeclineSeenCheck::
    .string "See ten kinds of POKéMON, then\n"
    .string "come back for your Lantern.$"
